{
  "name": "@preppilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build:web": "npx cross-env EXPO_PUBLIC_DEMO_MODE=true expo export --platform web --clear --output-dir dist",
    "demo": "pnpm build:web && pnpm serve:web",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "serve:web": "node ./scripts/serve-web.mjs dist",
    "start": "expo start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "web:demo": "npx cross-env EXPO_PUBLIC_DEMO_MODE=true expo start --web --port 8081",
    "apk": "eas build --platform android --profile preview",
    "apk:live": "eas build --platform android --profile preview-live",
    "logo:build": "node ./scripts/generate-logo-assets.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/log-box": "~57.0.3",
    "@expo/metro-runtime": "~57.0.12",
    "@preppilot/shared": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.9",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-kit": "^0.31.10",
    "eas-cli": "^22.4.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
