# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# Supabase project URL and anon key.
# The anon key is a PUBLISHABLE key: it is safe in the client because Row Level
# Security bounds what it can reach. The service-role key is NOT safe here and
# must never appear in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Set once a Google OAuth client exists; until then the Google
# sign-in option stays hidden rather than failing when tapped.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional. Phone OTP needs a Supabase SMS provider (and DLT registration for
# Indian numbers). Set to "true" once one is configured.
EXPO_PUBLIC_ENABLE_PHONE_OTP=false

# Optional. Lets the assistant answer without a signed-in account, so the demo
# build can use it. Requires the matching ALLOW_ANONYMOUS_AI secret on the Edge
# Function, and needs the Supabase URL and key above even in demo mode.
#
# The function's URL is public wherever the app runs, so switching this on means
# anyone who finds that URL can spend the project's Gemini quota. The proxy caps
# all anonymous callers together at 60 requests an hour for exactly that reason.
EXPO_PUBLIC_ALLOW_ANONYMOUS_AI=false

# Where the assistant sends requests, when that is not Supabase.
#
# Points at the Edge Function run locally (`pnpm ai:proxy`), which holds the
# Gemini key itself. This is what makes the assistant work before any Supabase
# project exists — including in demo mode. See docs/developer/AI_LOCALLY.md.
EXPO_PUBLIC_AI_PROXY_URL=

# The Gemini key, read by the local proxy only. Never prefixed EXPO_PUBLIC_:
# that would inline it into the bundle, where anyone with the app can read it.
GEMINI_API_KEY=
